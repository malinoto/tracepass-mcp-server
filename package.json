{
  "name": "tracepass-mcp-server",
  "mcpName": "eu.tracepass/tracepass",
  "version": "1.25.0",
  "description": "Model Context Protocol server for TracePass — the EU Digital Product Passport platform. Lets AI assistants manage products, passports, and EPCIS supply-chain events.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tracepass",
    "digital-product-passport",
    "dpp",
    "epcis",
    "gs1"
  ],
  "homepage": "https://www.tracepass.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malinoto/tracepass-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/malinoto/tracepass-mcp-server/issues"
  },
  "bin": {
    "tracepass-mcp-server": "dist/stdio.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:server-card": "npm run build --silent && node scripts/build-server-card.mjs",
    "check:server-card": "npm run build --silent && node scripts/build-server-card.mjs --check",
    "lint": "eslint src",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tracepass/code-standard": "github:malinoto/tracepass-code-standard#748db3c6f959459b6ea2bb8b97e4a17c2bf1864e",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
